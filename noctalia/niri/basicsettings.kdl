// Generated by niri-settings - Edits will be overwritten!

// prefer-no-csd

overview {
    zoom 0.5
}

animations {
    on
    slowdown 1.0
}

layout {
    shadow {
    on
    }

    gaps 16
    default-column-display "normal"
    default-column-width { proportion 0.5;}
    center-focused-column "never"
    // empty-workspace-above-first

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        on
        width 2
        active-color "#a6c8ff"
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#a6c8ff"
        inactive-color "#45475a"
    }

    insert-hint {
        // off
        color "#ffc87f70"
    }

    tab-indicator {
        corner-radius 8
        width 4
        length total-proportion=0.5
        gap 5
        gaps-between-tabs 2
    }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
}

input {
    // warp-mouse-to-focus
    // focus-follows-mouse
    // disable-power-key-handling
    // workspace-auto-back-and-forth
    mod-key "Super"

    touchpad {
        tap
        // dwt
        // dwtp
        natural-scroll
        drag true
        // drag-lock
        // disabled-on-external-mouse
        // left-handed
        click-method "button-areas"
        scroll-method "two-finger"
        accel-speed -0.18
        accel-profile "adaptive"
        tap-button-map "left-right-middle"
        scroll-factor 1.0
    }

    mouse {
        // natural-scroll
        // left-handed
        // middle-emulation
        accel-speed 0.00
        accel-profile "adaptive"
        scroll-factor 1.0
    }

    keyboard {
        track-layout "global"
        numlock
        xkb {
            layout "us,ru"
            options "kpdl:dot,grp:win_space_toggle"
        }
        repeat-delay 300
        repeat-rate 35
    }
}

hotkey-overlay {
    hide-not-bound
    skip-at-startup
    }

gestures {
    hot-corners {
        // off
    }
}

debug {
    // honor-xdg-activation-with-invalid-serial
}

cursor {
    hide-when-typing
    // hide-after-inactive-ms {self.behavior_tab.inactive_spinbox.value()}
}

screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d-%H-%M-%S.png"
